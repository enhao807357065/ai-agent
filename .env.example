APP_DEBUG=false
# ============================================================
# Provider 切换: talai | deepseek
# ============================================================
LLM_PROVIDER=talai

# ============================================================
# TAL AI 网关配置（LLM_PROVIDER=talai 时使用，OpenAI 兼容格式）
# ============================================================
LLM_BASE_URL=http://your-llm-gateway/openai-compatible/v1
LLM_API_KEY=your-api-key
LLM_MODEL=deepseek-v4-pro

# ============================================================
# DeepSeek 原厂配置（LLM_PROVIDER=deepseek 时使用，Anthropic API 格式）
# 文档：https://api-docs.deepseek.com/zh-cn/guides/anthropic_api
# ============================================================
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_MODEL=deepseek-reasoner
# DEEPSEEK_ENABLE_THINKING=false
# DEEPSEEK_THINKING_BUDGET=10000

# ============================================================
# 数据库配置
# ============================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-password
DB_NAME=ai_agent

# ============================================================
# 可选配置
# ============================================================
# DB_ECHO=false
# LOG_LEVEL=info

# ============================================================
# Agent Loop 配置
# ============================================================
# LLM_MAX_RETRIES=3          # LLM 调用最大重试次数
# LLM_RETRY_DELAY=1.0        # 重试基础延迟（秒），实际按指数退避

# ============================================================
# 模型限流配置（JSON 格式）
# 每个模型独立的滑动窗口限流，key 为模型名（需与实际调用的 model_name 匹配）
# rpm: 每分钟最大请求数
# tpm: 每分钟最大 token 数（input + output 合计）
# max_wait: 限流等待超时秒数（超时抛 RateLimitExceeded，默认 60）
# ============================================================
MODEL_RATE_LIMITS={"deepseek-reasoner":{"rpm":60,"tpm":100000},"deepseek-v4-pro":{"rpm":120,"tpm":200000}}
