# ============================================================
# Provider 切换: talai | deepseek
# ============================================================
LLM_PROVIDER=talai

# ============================================================
# TAL AI 网关配置（LLM_PROVIDER=talai 时使用，OpenAI 兼容格式）
# ============================================================
LLM_BASE_URL=http://your-llm-gateway/openai-compatible/v1
LLM_API_KEY=your-api-key
LLM_MODEL=deepseek-v4-pro

# ============================================================
# DeepSeek 原厂配置（LLM_PROVIDER=deepseek 时使用，Anthropic API 格式）
# 文档：https://api-docs.deepseek.com/zh-cn/guides/anthropic_api
# ============================================================
DEEPSEEK_API_KEY=sk-your-deepseek-key
# DEEPSEEK_ENABLE_THINKING=false
# DEEPSEEK_THINKING_BUDGET=10000

# ============================================================
# 数据库配置
# ============================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-password
DB_NAME=ai_agent

# ============================================================
# 可选配置
# ============================================================
# DB_ECHO=false
# LOG_LEVEL=info
