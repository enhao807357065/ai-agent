# ============================================================
# Application
# ============================================================
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false

# ============================================================
# Default model for legacy / non-Gateway callers
# Gateway requests must use a logical model from GATEWAY_ROUTING_POLICIES.
# Provider: talai | deepseek | deepseek_responses
# ============================================================
LLM_PROVIDER=talai
LLM_MODEL=deepseek-v4-pro
LLM_DEFAULT_TEMPERATURE=0.7
LLM_DEFAULT_TOP_P=1.0
LLM_DEFAULT_MAX_OUTPUT_TOKENS=4096

# ============================================================
# TAL AI: OpenAI-compatible Chat Completions API
# ============================================================
TALAI_BASE_URL=http://your-talai-gateway/openai-compatible/v1
TALAI_API_KEY=your-talai-api-key
TALAI_TIMEOUT_SECONDS=30
# Keep SDK retries disabled: Gateway Router owns retry, fallback and circuit breaking.
TALAI_SDK_MAX_RETRIES=0

# ============================================================
# DeepSeek direct API
# DEEPSEEK_BASE_URL: Anthropic-compatible adapter
# DEEPSEEK_RESPONSES_BASE_URL: Responses adapter
# ============================================================
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_RESPONSES_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_SDK_MAX_RETRIES=0
# Anthropic adapter only
DEEPSEEK_ENABLE_THINKING=false
DEEPSEEK_THINKING_BUDGET=10000
# Responses adapter only: none | low | medium | high
DEEPSEEK_REASONING_EFFORT=medium

# ============================================================
# Gateway Target Registry and logical routing policies
# Target Registry: real upstream targets, capabilities, limits, cost and priority.
# Routing Policies: public logical model -> candidate target pool.
# Secrets stay in the provider sections above; never put them in this JSON.
# ============================================================
GATEWAY_TARGET_REGISTRY={"talai/deepseek-v4-pro":{"id":"talai/deepseek-v4-pro","provider":"talai","model":"deepseek-v4-pro","capabilities":["chat","streaming","tool_calling","json_object"],"priority":20,"input_cost_per_million":"2.0","output_cost_per_million":"8.0","max_output_tokens":8192},"talai/deepseek-v4-flash":{"id":"talai/deepseek-v4-flash","provider":"talai","model":"deepseek-v4-flash","capabilities":["chat","streaming","tool_calling","json_object"],"priority":10,"input_cost_per_million":"0.5","output_cost_per_million":"2.0","max_output_tokens":8192},"deepseek/deepseek-v4-flash":{"id":"deepseek/deepseek-v4-flash","provider":"deepseek","model":"deepseek-v4-flash","capabilities":["chat","streaming","tool_calling","json_object","reasoning"],"priority":30,"input_cost_per_million":"4.0","output_cost_per_million":"16.0","max_output_tokens":8192,"enable_thinking":true},"deepseek_responses/deepseek-v4-flash":{"id":"deepseek_responses/deepseek-v4-flash","provider":"deepseek_responses","model":"deepseek-v4-flash","capabilities":["chat","streaming","tool_calling","json_object","json_schema","reasoning"],"priority":15,"input_cost_per_million":"1.0","output_cost_per_million":"4.0","max_output_tokens":8192,"reasoning_effort":"medium"}}
GATEWAY_ROUTING_POLICIES={"chat-default":{"target_ids":["talai/deepseek-v4-pro","deepseek/deepseek-v4-flash","deepseek_responses/deepseek-v4-flash"]},"chat-fast":{"target_ids":["talai/deepseek-v4-flash","talai/deepseek-v4-pro","deepseek_responses/deepseek-v4-flash"]},"reasoning-pro":{"target_ids":["deepseek/deepseek-v4-flash","deepseek_responses/deepseek-v4-flash"],"required_capabilities":["reasoning"]}}
GATEWAY_CIRCUIT_FAILURE_THRESHOLD=3
GATEWAY_CIRCUIT_OPEN_SECONDS=60

# Legacy route map: retained only for compatibility with previous exercises.
# GatewayModelRouter uses GATEWAY_TARGET_REGISTRY + GATEWAY_ROUTING_POLICIES.
GATEWAY_MODEL_ROUTES={"chat-default":{"primary":{"provider":"talai","model":"deepseek-v4-pro"},"fallbacks":[{"provider":"deepseek","model":"deepseek-v4-flash"}]},"chat-fast":{"primary":{"provider":"talai","model":"deepseek-v4-flash"},"fallbacks":[{"provider":"talai","model":"deepseek-v4-pro"}]},"reasoning-pro":{"primary":{"provider":"deepseek","model":"deepseek-v4-flash","enable_thinking":true},"fallbacks":[{"provider":"talai","model":"deepseek-v4-pro"}]}}

# ============================================================
# Gateway and Agent Run limits
# LLM_MAX_RETRIES / LLM_RETRY_DELAY are legacy compatibility settings.
# Gateway Router uses its own per-target retry policy.
# ============================================================
RUN_BUFFER_TTL=3600
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=1.0
RATE_LIMIT_ENABLED=true
# Key = logical model; RPM and TPM are shared by Gateway HTTP and Agent turns.
MODEL_RATE_LIMITS={"chat-default":{"rpm":60,"tpm":100000},"chat-fast":{"rpm":120,"tpm":200000},"reasoning-pro":{"rpm":30,"tpm":100000}}

# ============================================================
# Database
# ============================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-password
DB_NAME=ai_agent
DB_ECHO=false
