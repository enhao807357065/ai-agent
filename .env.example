APP_DEBUG=false
# ============================================================
# Provider 切换: talai | deepseek | deepseek_responses
# ============================================================
LLM_PROVIDER=deepseek

# ============================================================
# TAL AI 网关配置（LLM_PROVIDER=talai 时使用，OpenAI 兼容格式）
# ============================================================
TALAI_BASE_URL=http://your-talai-gateway/openai-compatible/v1
TALAI_API_KEY=your-talai-api-key
LLM_MODEL=deepseek-v4-pro

# ============================================================
# DeepSeek 原厂配置（LLM_PROVIDER=deepseek / deepseek_responses 共用）
# Anthropic 格式文档：https://api-docs.deepseek.com/zh-cn/guides/anthropic_api
# Responses API 文档：https://api-docs.deepseek.com/zh-cn/guides/responses_api
# ============================================================
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_RESPONSES_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_ENABLE_THINKING=false       # Anthropic adapter 专用
# DEEPSEEK_THINKING_BUDGET=10000       # Anthropic adapter 专用
# DEEPSEEK_REASONING_EFFORT=medium     # Responses adapter 专用: none | low | medium | high

# Gateway Phase 1-3：Target Registry 声明具体目标的能力、优先级、价格与限制；路由策略只声明候选池。
# Router 先按请求的 streaming/tool_calling/json_* 能力过滤，再按 priority → estimated_cost → health 选择。
# 连续可恢复失败达到阈值后会暂时熔断该 target；密钥仍只保留在对应 provider 配置中。
GATEWAY_TARGET_REGISTRY={"talai/deepseek-v4-pro":{"id":"talai/deepseek-v4-pro","provider":"talai","model":"deepseek-v4-pro","capabilities":["chat","streaming","tool_calling","json_object"],"priority":20,"input_cost_per_million":"2.0","output_cost_per_million":"8.0","max_output_tokens":8192},"talai/deepseek-v4-flash":{"id":"talai/deepseek-v4-flash","provider":"talai","model":"deepseek-v4-flash","capabilities":["chat","streaming","tool_calling","json_object"],"priority":10,"input_cost_per_million":"0.5","output_cost_per_million":"2.0","max_output_tokens":8192},"deepseek_responses/deepseek-v4-flash":{"id":"deepseek_responses/deepseek-v4-flash","provider":"deepseek_responses","model":"deepseek-v4-flash","capabilities":["chat","streaming","tool_calling","json_object","json_schema","reasoning"],"priority":15,"input_cost_per_million":"1.0","output_cost_per_million":"4.0","max_output_tokens":8192}}
GATEWAY_ROUTING_POLICIES={"chat-default":{"target_ids":["talai/deepseek-v4-pro","deepseek_responses/deepseek-v4-flash"]},"chat-fast":{"target_ids":["talai/deepseek-v4-flash","talai/deepseek-v4-pro","deepseek_responses/deepseek-v4-flash"]},"reasoning-pro":{"target_ids":["deepseek_responses/deepseek-v4-flash"],"required_capabilities":["reasoning"]}}
GATEWAY_CIRCUIT_FAILURE_THRESHOLD=3
GATEWAY_CIRCUIT_OPEN_SECONDS=60

# ============================================================
# 数据库配置
# ============================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-password
DB_NAME=ai_agent

# ============================================================
# 可选配置
# ============================================================
# DB_ECHO=false
# LOG_LEVEL=info

# ============================================================
# Gateway / Agent Loop 配置
# ============================================================
# LLM_MAX_RETRIES=3          # 仅保留给兼容配置；上游 fallback 由 Gateway Router 管理
# LLM_RETRY_DELAY=1.0        # 兼容配置

# RATE_LIMIT_ENABLED=true       # false 时完全关闭限流：不等待、不记账、不创建窗口

# ============================================================
# Gateway 逻辑模型限流配置（JSON 格式）
# Gateway HTTP 与每个 Agent Turn 共用滑动窗口限流；key 必须是逻辑模型名。
# rpm: 每分钟最大请求数
# tpm: 每分钟最大 token 数（input + output 合计）
# max_wait: 限流等待超时秒数（超时返回 429 / RateLimitExceeded）
# ============================================================
MODEL_RATE_LIMITS={"chat-default":{"rpm":60,"tpm":100000},"chat-fast":{"rpm":120,"tpm":200000},"reasoning-pro":{"rpm":30,"tpm":100000}}
